{
	"name": "api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @acme/core build && nest start --watch",
		"build": "nest build",
		"start": "node dist/main.js",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@acme/core": "workspace:*",
		"@nestjs/common": "12.5.1",
		"@nestjs/core": "12.5.1",
		"@nestjs/drizzle": "0.0.2",
		"@nestjs/platform-express": "12.5.1",
		"drizzle-orm": "0.45.4",
		"postgres": "4.1.1",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.5.16",
		"@nestjs/cli": "12.0.13",
		"@nestjs/schematics": "12.0.13",
		"@nestjs/testing": "12.5.1",
		"@types/express": "5.0.6",
		"@types/node": "^24",
		"@types/supertest": "7.2.1",
		"drizzle-kit": "0.31.11",
		"supertest": "7.3.2"
	}
}
