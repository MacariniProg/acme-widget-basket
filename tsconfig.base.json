{
	"compilerOptions": {
		"target": "es2024",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		// Type-check and test against @acme/core's source. Node, running built code, gets its dist/ (see packages/core/package.json).
		"customConditions": ["@acme/source"],
		"noEmit": true
	}
}
